+  sessionId: string,
+  maxChars = 3000,
+): string {
+  const db = getDb();
+  if (!db) return "";
+
+  const rows = db
+    .prepare(
+      `SELECT id, role, content
+       FROM messages
+       WHERE session_id = ? AND role IN ('user', 'assistant')
+         AND content IS NOT NULL
+       ORDER BY timestamp, id`,
+    )
+    .all(sessionId) as Array<{
+    id: number;
+    role: string;
+    content: string | null;
+  }>;
